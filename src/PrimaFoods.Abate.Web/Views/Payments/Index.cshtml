@model PaymentDashboardResult
@{
    ViewData["Title"] = "Pagamento de animais abatidos";
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables.net-bs5/css/dataTables.bootstrap5.min.css" />
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
    <div>
        <h1 class="h3 mb-1"><strong>Pagamento</strong> de animais abatidos</h1>
        @if (Model.CalculatedAt is { } calculatedAt)
        {
            <p class="text-muted mb-0">Último cálculo em @calculatedAt.ToString("dd/MM/yyyy HH:mm")</p>
        }
    </div>
    <form asp-action="Calculate" method="post">
        <button type="submit" class="btn btn-primary">
            <i class="align-middle" data-feather="refresh-cw"></i>
            <span class="align-middle">Processar pagamentos</span>
        </button>
    </form>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}

@if (!Model.HasData)
{
    <div class="alert alert-info">
        Nenhum pagamento calculado ainda. Clique em <strong>Processar pagamentos</strong> para executar o cálculo.
    </div>
}
else
{
    <partial name="_Indicators" model="Model" />

    <div class="card">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs" id="payment-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="summary-tab" data-bs-toggle="tab" data-bs-target="#summary-pane"
                            type="button" role="tab" aria-controls="summary-pane" aria-selected="true">
                        Resumo por pedido
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="animals-tab" data-bs-toggle="tab" data-bs-target="#animals-pane"
                            type="button" role="tab" aria-controls="animals-pane" aria-selected="false">
                        Detalhe por animal
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="tab-content">
                <div class="tab-pane fade show active" id="summary-pane" role="tabpanel" aria-labelledby="summary-tab" tabindex="0">
                    <partial name="_OrderSummaries" model="Model" />
                </div>
                <div class="tab-pane fade" id="animals-pane" role="tabpanel" aria-labelledby="animals-tab" tabindex="0">
                    <partial name="_AnimalDetails" model="Model.Animals" />
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/datatables.net/js/dataTables.min.js"></script>
    <script src="~/lib/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/payments.js" asp-append-version="true"></script>
}