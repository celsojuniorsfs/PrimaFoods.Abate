@model PaymentDashboardResult

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle text-nowrap mb-0">
        <thead class="table-light">
            <tr>
                <th scope="col">Pedido</th>
                <th scope="col">Fornecedor</th>
                <th scope="col">Sexo</th>
                <th scope="col" class="text-end">Animais</th>
                <th scope="col" class="text-end">Peso total (kg)</th>
                <th scope="col" class="text-end">Arrobas</th>
                <th scope="col" class="text-end">Ágio</th>
                <th scope="col" class="text-end">Deságio</th>
                <th scope="col" class="text-end">Valor total</th>
                <th scope="col" class="text-end">Valor unit. @@</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.OrderSummaries)
            {
                <tr>
                    <td>@row.OrderId</td>
                    <td>@row.Supplier</td>
                    <td>@row.Sex.ToDisplay()</td>
                    <td class="text-end">@row.Totals.AnimalCount.ToString("N0")</td>
                    <td class="text-end">@row.Totals.TotalWeight.ToString("N2")</td>
                    <td class="text-end">@row.Totals.TotalArrobas.ToString("N2")</td>
                    <td class="text-end">@AmountHtml.Premium(row.Totals.TotalPremium)</td>
                    <td class="text-end">@AmountHtml.Discount(row.Totals.TotalDiscount)</td>
                    <td class="text-end fw-semibold">@row.Totals.TotalAmount.ToString("C")</td>
                    <td class="text-end">@row.Totals.ArrobaUnitPrice.ToString("C")</td>
                </tr>
            }
        </tbody>
        <tfoot class="table-group-divider fw-semibold">
            <tr>
                <td colspan="3">Total geral</td>
                <td class="text-end">@Model.GrandTotals.AnimalCount.ToString("N0")</td>
                <td class="text-end">@Model.GrandTotals.TotalWeight.ToString("N2")</td>
                <td class="text-end">@Model.GrandTotals.TotalArrobas.ToString("N2")</td>
                <td class="text-end">@AmountHtml.Premium(Model.GrandTotals.TotalPremium)</td>
                <td class="text-end">@AmountHtml.Discount(Model.GrandTotals.TotalDiscount)</td>
                <td class="text-end">@Model.GrandTotals.TotalAmount.ToString("C")</td>
                <td class="text-end">@Model.GrandTotals.ArrobaUnitPrice.ToString("C")</td>
            </tr>
        </tfoot>
    </table>
</div>