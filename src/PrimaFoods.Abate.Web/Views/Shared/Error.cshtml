@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-xl-6">
        <div class="card">
            <div class="card-body text-center p-4">
                <div class="mb-3 text-danger">
                    <i data-feather="alert-triangle" style="width: 48px; height: 48px;"></i>
                </div>
                <h1 class="h3 text-danger">Não foi possível concluir a operação.</h1>
                <p class="mb-4">Tente novamente em instantes. Se o problema continuar, verifique se o banco de dados está em execução.</p>

                @if (Model.ShowRequestId)
                {
                    <p class="text-muted small">Código da requisição: <code>@Model.RequestId</code></p>
                }

                <a class="btn btn-primary" asp-controller="Payments" asp-action="Index">Voltar para Pagamentos</a>
            </div>
        </div>
    </div>
</div>
