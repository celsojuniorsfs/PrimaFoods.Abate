@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<h1 class="h3 text-danger">Não foi possível concluir a operação.</h1>
<p>Tente novamente em instantes. Se o problema continuar, verifique se o banco de dados está em execução.</p>

@if (Model.ShowRequestId)
{
    <p class="text-body-secondary small mb-0">Código da requisição: <code>@Model.RequestId</code></p>
}