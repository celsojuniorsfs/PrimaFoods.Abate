{
  "version": "3.0",
  "defaultProvider": "jsdelivr",
  "libraries": [
    {
      "library": "@adminkit/core@3.5.0",
      "destination": "wwwroot/lib/adminkit",
      "files": [
        "dist/css/app.css",
        "dist/js/app.js"
      ]
    },
    {
      "library": "notyf@3.10.0",
      "destination": "wwwroot/lib/notyf",
      "files": [
        "notyf.min.css",
        "notyf.min.js"
      ]
    },
    {
      "library": "datatables.net@2.3.4",
      "destination": "wwwroot/lib/datatables.net",
      "files": [
        "js/dataTables.min.js"
      ]
    },
    {
      "library": "datatables.net-bs5@2.3.4",
      "destination": "wwwroot/lib/datatables.net-bs5",
      "files": [
        "js/dataTables.bootstrap5.min.js",
        "css/dataTables.bootstrap5.min.css"
      ]
    }
  ]
}